# runtime state (SQLite DB, WAL, image proxy cache, server-side exports)
var/
*.db
*.db-wal
*.db-shm
# images are never committed: rebuild with scripts/fetch_images.py (or use Git LFS, see README)
images/
thumbs/
cache/
*.jpg
*.jpeg
*.png
!app/icon-*.png
# e2e output (screenshots contain dataset images)
screenshots/
# python / editor
__pycache__/
*.pyc
.venv/
.env
.DS_Store

# secrets / local-only
ACCESS_CODE.txt
.space-build/
# face-blurred release copies (scripts/auto_blur.py); like images/, never committed
images_blurred/

# offline review viewer: images are handed over in person, never committed
review/images/
