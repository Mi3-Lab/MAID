# Per-annotator event logs are append-only JSONL: if the same annotator appends on two branches/devices,
# a union merge keeps both sets of lines (duplicates by uuid are ignored by every reader).
annotations/events/*.jsonl merge=union
# derived/ is generated by CI; never merge it by hand -- regenerate with scripts/build_derived.py
derived/** linguist-generated=true -diff
data/*.csv -diff
annotations/events/*.jsonl text eol=lf
*.ps1 text eol=crlf
*.vbs text eol=crlf
